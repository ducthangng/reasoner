# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...
# Postgres connection string — Railway injects this when you reference the Postgres service
DATABASE_URL=postgres://postgres:postgres@localhost:5432/reasoner
# Set to "true" when connecting to a Postgres that requires SSL (e.g. Railway's public URL)
PGSSL=false
# Comma-separated list of allowed frontend origins (your Vercel domain)
CORS_ORIGINS=http://localhost:5173
# Optional overrides
# Default model; users can pick another in the app
OPENAI_MODEL=gpt-5.5
CONCEPT_COUNT=25
PORT=8080
