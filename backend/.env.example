# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...
# Postgres connection string. Locally, `npm run db:local` serves the URL below; on Railway, reference the Postgres service
DATABASE_URL=postgres://postgres:postgres@localhost:5433/reasoner
# Password users must enter before a paper is analyzed (required; analysis is disabled without it)
ANALYZE_PASSWORD=change-me
# Set to "true" when connecting to a Postgres that requires SSL (e.g. Railway's public URL)
PGSSL=false
# Comma-separated list of allowed frontend origins (your Vercel domain)
CORS_ORIGINS=http://localhost:5173
# Optional overrides
# Default model; users can pick another in the app
OPENAI_MODEL=gpt-5.5-2026-04-23
PORT=8080

# PDF storage in AWS S3. Leave S3_BUCKET empty to keep PDFs in Postgres (fine for local dev).
S3_BUCKET=
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: key prefix inside the bucket, and a custom endpoint for S3-compatible stores
S3_PREFIX=papers/
S3_ENDPOINT=
